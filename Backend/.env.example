APP_NAME=Sales tracker Portal
APP_ENV=development
SERVER_PORT=8080

# Database
DB_HOST=your-session-pooler-host
DB_PORT=5432
DB_USER=postgres.your-project-reference
DB_PASSWORD=your-password
DB_NAME=postgres
DB_SSLMODE=require  

# JWT Configuration
JWT_SECRET=your_secret_key_must_be_at_least_32_chars_long

# Microsoft Entra ID (Single Tenant) Credentials
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h
TEMP_TOKEN_EXPIRY=30m
MFA_PENDING_TOKEN_EXPIRY=10m

# SSO Callbacks
SSO_CALLBACK_URL=http://localhost:8080/api/v1/auth/sso/callback
FRONTEND_SSO_REDIRECT_URL=http://localhost:3000/sso-success

# Rate Limiter
MMAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m
 
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=example@gmail.com
SMTP_PASSWORD=password
 
# Logging
LOG_LEVEL=INFO
